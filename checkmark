  <style>
    :root {
      --ink: #111111;
      --ink-hover: #242424;
      --ink-pressed: #050505;
    }

    html {
      background: #ffffff;
    }

    body {
      width: 100%;
      margin: 0;
      font-family: "DM Sans", sans-serif;
    }

    .check-shell {
      animation: enter 520ms cubic-bezier(0.22, 1, 0.36, 1) both;
    }

    .quest-checkbox {
      width: 6rem;
      height: 6rem;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      border: 0;
      border-radius: 1rem;
      background: linear-gradient(110deg, #080808 0%, #242424 58%, #101010 100%);
      box-shadow:
        inset 1px 1px 0 rgba(255, 255, 255, 0.11),
        inset -1px -1px 0 rgba(0, 0, 0, 0.35),
        0 8px 18px rgba(0, 0, 0, 0.12);
      cursor: pointer;
      transition: transform 180ms ease, box-shadow 180ms ease, background 180ms ease;
      -webkit-tap-highlight-color: transparent;
    }

    .quest-checkbox:hover {
      background: linear-gradient(110deg, #151515 0%, #303030 58%, #171717 100%);
      box-shadow:
        inset 1px 1px 0 rgba(255, 255, 255, 0.13),
        inset -1px -1px 0 rgba(0, 0, 0, 0.35),
        0 12px 24px rgba(0, 0, 0, 0.15);
      transform: translateY(-2px);
    }

    .quest-checkbox:active {
      background: var(--ink-pressed);
      box-shadow:
        inset 1px 1px 2px rgba(0, 0, 0, 0.35),
        inset -1px -1px 0 rgba(255, 255, 255, 0.06);
      transform: translateY(1px) scale(0.97);
    }

    .quest-checkbox:focus-visible {
      outline: 3px solid #2f80ed;
      outline-offset: 5px;
    }

    .check-icon {
      width: 2.25rem;
      height: 2.25rem;
      color: #ffffff;
      stroke-width: 3;
      opacity: 0;
      transform: scale(0.56);
      transition: opacity 170ms ease, transform 230ms cubic-bezier(0.22, 1, 0.36, 1);
    }

    .quest-checkbox.is-checked .check-icon {
      opacity: 1;
      transform: scale(1);
    }

    @keyframes enter {
      from {
        opacity: 0;
        transform: translateY(10px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    @media (prefers-reduced-motion: reduce) {
      .check-shell,
      .quest-checkbox,
      .check-icon {
        animation: none;
        transition: none;
      }
    }
  </style>
