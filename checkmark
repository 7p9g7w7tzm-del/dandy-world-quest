 <body data-template-id="__page-root" class="w-full min-h-screen flex items-center justify-center px-6" style="background: rgb(255, 255, 255);">
  <main class="w-full flex justify-center" aria-labelledby="quest-label">
   <section class="check-shell flex flex-col items-center gap-5 text-center"><button id="quest-checkbox" data-template-id="quest-checkbox" class="quest-checkbox canva-button" type="button" role="checkbox" aria-checked="false" aria-labelledby="quest-label" style="background: linear-gradient(110deg, rgb(8, 8, 8), rgb(36, 36, 36), rgb(16, 16, 16));"> <i data-lucide="check" class="check-icon" aria-hidden="true"></i> </button>
    <p id="quest-status" class="sr-only" aria-live="polite"></p>
   </section>
  </main>
  <script src="/_sdk/d80b7fc77c36e544.editing_sdk.js" integrity="sha512-G1c7mLHfqSpyYPFnCMpb8X52/iP9EEJ4y/O8pmYPhWe33R+uuxRRWVYdXU2F+N4m0Y2/2lhbJGfxoPXkVhIZzw=="></script>
  <script>
    document.addEventListener("DOMContentLoaded", function () {
      lucide.createIcons();

      const checkbox = document.getElementById("quest-checkbox");
      const status = document.getElementById("quest-status");
      let isChecked = false;

      function updateCheckbox() {
        checkbox.classList.toggle("is-checked", isChecked);
        checkbox.setAttribute("aria-checked", String(isChecked));
        checkbox.setAttribute(
          "aria-label",
          isChecked ? "Daily quest complete, checked" : "Daily quest complete, unchecked"
        );
        status.textContent = isChecked
          ? "Daily quest marked complete."
          : "Daily quest marked incomplete.";
      }

      checkbox.addEventListener("click", function () {
        isChecked = !isChecked;
        updateCheckbox();
      });

      updateCheckbox();
    });
  </script>
 
